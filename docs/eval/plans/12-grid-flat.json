    {"type":"window","between":["exterior","cozinha"],"on":{"room":"cozinha","side":"east"},"width":1.4},
    {"type":"window","between":["exterior","quarto"],"on":{"room":"quarto","side":"south"},"width":1.6},
    {"type":"window","between":["exterior","banho"],"on":{"room":"banho","side":"south"},"width":0.6}
